#!/usr/bin/env bash
# collar-migrate-gstack — gstack learnings.jsonl → collar .collar/insights.jsonl 이관
#
# gstack 의 운영 인사이트를 collar 메모리로 가져온다. (doc/2026-05-14-memory-system-design.md §1.1/§4)
# 소스: ${GSTACK_HOME:-$HOME/.gstack}/projects/{slug}/learnings.jsonl
#   gstack 스키마: {"skill","type","key","insight","confidence","source"}
# 타깃: ./.collar/insights.jsonl
#   collar 스키마: {"date","project","title","discovery","context","application","source","confidence"}
#
# 멱등성: (title+discovery) 가 이미 있으면 스킵. 여러 번 실행해도 안전.
# 소스가 없으면 에러 없이 스킵(0 종료) — collar 철학(미연결 시 skip).
#
# 사용법:
#   collar-migrate-gstack                 # slug = 현재 디렉토리명
#   collar-migrate-gstack --slug myproj
#   collar-migrate-gstack --gstack-home /custom/.gstack
#   collar-migrate-gstack --dry-run       # 미리보기만, 기록 안 함

set -euo pipefail

TARGET="$(pwd)"
TODAY="$(date +%Y-%m-%d)"
GSTACK_HOME="${GSTACK_HOME:-$HOME/.gstack}"
SLUG="$(basename "$TARGET")"
DRY_RUN="false"

while [ $# -gt 0 ]; do
  case "$1" in
    --slug)        SLUG="${2:-$SLUG}"; shift 2 ;;
    --gstack-home) GSTACK_HOME="${2:-$GSTACK_HOME}"; shift 2 ;;
    --dry-run)     DRY_RUN="true"; shift ;;
    -h|--help)     grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)             echo "알 수 없는 인자: $1" >&2; exit 1 ;;
  esac
done

if [ ! -d "$TARGET/.collar" ]; then
  echo "❌ .collar 디렉토리가 없습니다. 먼저 collar-init 을 실행하세요." >&2
  exit 1
fi

SRC="$GSTACK_HOME/projects/$SLUG/learnings.jsonl"
DEST="$TARGET/.collar/insights.jsonl"

if [ ! -f "$SRC" ]; then
  echo "ℹ️  gstack learnings 없음 — 스킵: $SRC"
  echo "   (slug 다르면: collar-migrate-gstack --slug <이름>)"
  exit 0
fi

echo "📥 gstack → collar 이관: $SRC"
[ "$DRY_RUN" = "true" ] && echo "   (--dry-run: 기록하지 않고 미리보기만)"

python3 - "$SRC" "$DEST" "$TODAY" "$SLUG" "$DRY_RUN" << 'PYEOF'
import sys, json, pathlib

src, dest, today, slug, dry = sys.argv[1:6]
dry = (dry == "true")

dest_path = pathlib.Path(dest)

# 기존 타깃에서 (title, discovery) 키 집합 — 중복 방지
seen = set()
if dest_path.exists():
    for line in dest_path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            d = json.loads(line)
        except json.JSONDecodeError:
            continue
        seen.add((d.get("title"), d.get("discovery")))

migrated = 0
skipped = 0
malformed = 0
records = []

for line in pathlib.Path(src).read_text().splitlines():
    line = line.strip()
    if not line:
        continue
    try:
        g = json.loads(line)
    except json.JSONDecodeError:
        malformed += 1
        continue

    title = g.get("key", "") or (g.get("insight", "")[:40])
    discovery = g.get("insight", "")
    if not discovery:
        malformed += 1
        continue

    if (title, discovery) in seen:
        skipped += 1
        continue
    seen.add((title, discovery))

    skill = g.get("skill", "gstack")
    gtype = g.get("type", "")
    gsource = g.get("source", "")
    try:
        confidence = int(g.get("confidence", 5))
    except (ValueError, TypeError):
        confidence = 5

    record = {
        "date": today,
        "project": slug,
        "title": title,
        "discovery": discovery,
        "context": f"gstack:{skill}/{gtype}".rstrip("/"),
        "application": "",
        "source": f"gstack:{gsource}".rstrip(":") if gsource else "gstack",
        "confidence": confidence,
    }
    records.append(record)
    migrated += 1

if dry:
    for r in records:
        print("  + " + r["title"])
else:
    if records:
        with dest_path.open("a", encoding="utf-8") as f:
            for r in records:
                f.write(json.dumps(r, ensure_ascii=False) + "\n")

print(f"RESULT migrated={migrated} skipped={skipped} malformed={malformed}")
PYEOF

echo "✅ 이관 완료 → $DEST"
