#!/usr/bin/env bash
# collar-github — GitHub 이슈 자동 처리 파이프라인
#
# 동작:
#   1. GitHub 미처리 이슈 수집
#   2. LLM이 이슈 분류 (bug / feature / question / skip)
#   3. bug → 코드 분석 + 수정 PR 자동 생성
#      feature → 로드맵 기록 (복잡도 낮으면 PR까지)
#      question → 자동 답변 댓글
#   4. .collar/github-processed.log에 처리 이력 기록
#
# 사용법:
#   collar-github setup   GitHub 연동 설정 (토큰, 레포)
#   collar-github run     미처리 이슈 일괄 처리
#   collar-github status  현재 상태 확인
#   collar-github watch   SessionStart 훅으로 자동 감시 등록

set -euo pipefail

# COLLAR_HOME은 스크립트 위치 기준으로 동적 계산한다(다른 collar-* 스크립트와 동일).
# 개발자 절대경로 하드코딩 시 ~/.collar 설치 환경·타 사용자 환경에서 templates 참조가 깨진다.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COLLAR_HOME="${COLLAR_HOME:-$(cd "$SCRIPT_DIR/.." && pwd)}"
TARGET="${COLLAR_GITHUB_TARGET:-$(pwd)}"
COLLAR_DIR="$TARGET/.collar"
CONFIG_FILE="$COLLAR_DIR/config.json"
PROCESSED_LOG="$COLLAR_DIR/github-processed.log"
GITHUB_CONFIG="$COLLAR_DIR/github.json"

SUBCOMMAND="${1:-help}"

# ── 헬퍼 ──────────────────────────────────────────────────────────
die() { echo "❌ $*" >&2; exit 1; }
log()  { echo "[collar-github] $*"; }

require_collar() {
  [ -d "$COLLAR_DIR" ] || die ".collar 없음. collar-init 먼저 실행하세요."
}

require_gh() {
  command -v gh >/dev/null 2>&1 || die "gh CLI 없음. brew install gh 후 gh auth login"
  gh auth status >/dev/null 2>&1 || die "gh 미인증. 'gh auth login' 실행"
}

# ── setup ─────────────────────────────────────────────────────────
cmd_setup() {
  require_collar
  require_gh

  echo "🔧 collar-github setup"
  echo ""

  # 레포 URL 자동 감지
  REPO_URL="$(git -C "$TARGET" remote get-url origin 2>/dev/null || echo "")"
  if [ -z "$REPO_URL" ]; then
    echo "GitHub 레포 URL을 입력하세요 (예: owner/repo):"
    read -r REPO_SLUG
  else
    # https://github.com/owner/repo.git → owner/repo
    REPO_SLUG="$(echo "$REPO_URL" | sed 's|.*github.com[:/]||' | sed 's|\.git$||')"
    echo "감지된 레포: $REPO_SLUG"
    read -p "맞습니까? [Y/n]: " CONFIRM
    [ "$CONFIRM" = "n" ] || [ "$CONFIRM" = "N" ] && { echo "직접 입력:"; read -r REPO_SLUG; }
  fi

  # 자동처리 옵션
  echo ""
  echo "자동처리 수준 설정:"
  echo "  [1] 분류만 (이슈에 라벨 + 댓글) — 안전"
  echo "  [2] 분류 + bug 자동 수정 PR — 권장"
  echo "  [3] 분류 + bug 수정 + feature PR (단순한 것만) — 공격적"
  read -p "선택 [1/2/3, 기본 2]: " AUTO_LEVEL
  AUTO_LEVEL="${AUTO_LEVEL:-2}"

  # github.json 저장
  python3 -c "
import json, pathlib, datetime
cfg = {
    'repo': '$REPO_SLUG',
    'auto_level': int('$AUTO_LEVEL'),
    'enabled': True,
    'setup_at': '$(date +%Y-%m-%dT%H:%M:%S)',
    'watch_on_session': True
}
pathlib.Path('$GITHUB_CONFIG').write_text(json.dumps(cfg, indent=2))
print('OK')
"
  # config.json의 github.enabled 갱신
  python3 -c "
import json, pathlib
p = pathlib.Path('$CONFIG_FILE')
d = json.loads(p.read_text())
d['github']['enabled'] = True
d['github']['repo'] = '$REPO_SLUG'
d['github']['auto_level'] = int('$AUTO_LEVEL')
p.write_text(json.dumps(d, indent=2, ensure_ascii=False))
" 2>/dev/null || true

  touch "$PROCESSED_LOG"

  # ANTHROPIC_API_KEY 설정 (버그 자동수정에 필요)
  echo ""
  if [ -z "${ANTHROPIC_API_KEY:-}" ]; then
    STORED_KEY="$(security find-generic-password -s "collar-github-anthropic-key" -w 2>/dev/null || true)"
    if [ -z "$STORED_KEY" ]; then
      echo "ANTHROPIC_API_KEY가 설정되어 있지 않습니다 (버그 자동 수정에 필요)."
      echo "Anthropic API 키를 입력하세요 (없으면 Enter로 건너뜀):"
      read -rs API_KEY_INPUT
      if [ -n "$API_KEY_INPUT" ]; then
        security add-generic-password -s "collar-github-anthropic-key" \
          -a "collar-github" -w "$API_KEY_INPUT" 2>/dev/null || \
          echo "export ANTHROPIC_API_KEY=$API_KEY_INPUT" >> "$HOME/.zshrc"
        echo "✅ API 키 저장 완료 (Keychain)"
      else
        echo "⚠️  API 키 없음. 버그 자동수정은 ANTHROPIC_API_KEY 환경변수 필요."
      fi
    else
      echo "✅ API 키 이미 저장됨 (Keychain)"
    fi
  else
    echo "✅ ANTHROPIC_API_KEY 환경변수 감지됨"
  fi

  echo ""
  echo "✅ collar-github 설정 완료: $REPO_SLUG (레벨 $AUTO_LEVEL)"
  echo ""
  echo "실행: collar-github run"
  echo "자동 감시 등록: collar-github watch"
}

# ── status ────────────────────────────────────────────────────────
cmd_status() {
  require_collar
  echo "── collar-github 상태 ──"
  if [ -f "$GITHUB_CONFIG" ]; then
    python3 -c "
import json, pathlib
cfg = json.loads(pathlib.Path('$GITHUB_CONFIG').read_text())
print('  레포:      ' + cfg.get('repo', '미설정'))
print('  자동처리:  레벨 ' + str(cfg.get('auto_level', 0)))
print('  활성화:    ' + ('✅' if cfg.get('enabled') else '❌'))
print('  설정일:    ' + cfg.get('setup_at', '?'))
"
  else
    echo "  ❌ 미설정. collar-github setup 실행"
  fi
  echo ""
  if [ -f "$PROCESSED_LOG" ]; then
    COUNT=$(wc -l < "$PROCESSED_LOG" | tr -d ' ')
    echo "  처리 이력: ${COUNT}건"
    [ "$COUNT" -gt 0 ] && tail -5 "$PROCESSED_LOG" | sed 's/^/    /'
  fi
}

# ── run ───────────────────────────────────────────────────────────
cmd_run() {
  require_collar
  require_gh

  [ -f "$GITHUB_CONFIG" ] || die "설정 없음. collar-github setup 먼저 실행"
  REPO="$(python3 -c "import json,pathlib; print(json.loads(pathlib.Path('$GITHUB_CONFIG').read_text()).get('repo',''))")"
  AUTO_LEVEL="$(python3 -c "import json,pathlib; print(json.loads(pathlib.Path('$GITHUB_CONFIG').read_text()).get('auto_level',2))")"
  [ -z "$REPO" ] && die "레포 미설정. collar-github setup 재실행"

  echo "🔍 collar-github run: $REPO (레벨 $AUTO_LEVEL)"
  echo ""

  # 처리된 이슈 번호 목록
  touch "$PROCESSED_LOG"
  PROCESSED_IDS="$(grep -oE '#[0-9]+' "$PROCESSED_LOG" 2>/dev/null | tr -d '#' | sort -u || true)"

  # 미처리 이슈 수집
  ISSUES="$(gh issue list --repo "$REPO" --state open --json number,title,body,labels \
    --limit 20 2>/dev/null || echo "[]")"

  ISSUE_COUNT="$(echo "$ISSUES" | python3 -c "import json,sys; print(len(json.load(sys.stdin)))")"
  echo "📋 열린 이슈: ${ISSUE_COUNT}건"
  echo ""

  if [ "$ISSUE_COUNT" = "0" ]; then
    echo "처리할 이슈 없음."
    exit 0
  fi

  # 이슈별 처리 (issues를 임시 파일로 전달 — pipe+heredoc stdin 충돌 방지)
  ISSUES_TMP="$(mktemp /tmp/collar-github-issues.XXXXXX.json)"
  chmod 600 "$ISSUES_TMP"
  echo "$ISSUES" > "$ISSUES_TMP"
  trap "rm -f $ISSUES_TMP" EXIT

  python3 - "$REPO" "$AUTO_LEVEL" "$PROCESSED_LOG" "$PROCESSED_IDS" "$TARGET" "$COLLAR_HOME" "$ISSUES_TMP" << 'PYEOF'
import sys, json, subprocess, pathlib, datetime, os, time

repo = sys.argv[1]
auto_level = int(sys.argv[2])
log_path = pathlib.Path(sys.argv[3])
processed_str = sys.argv[4]
project_dir = sys.argv[5]
collar_home = sys.argv[6]
issues_file = sys.argv[7]

issues = json.loads(pathlib.Path(issues_file).read_text())
processed = set(processed_str.split()) if processed_str else set()

_usage_log = pathlib.Path(collar_home) / "usage.log"

def log_usage(provider: str, model: str, task: str, ms: int, status: str):
    ts = datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
    line = f"{ts}\tgithub\t{provider}\t{model}\t{task}\t{ms}\t{status}\n"
    try:
        _usage_log.open("a").write(line)
    except Exception:
        pass

def run(cmd, **kw):
    return subprocess.run(cmd, shell=True, capture_output=True, text=True, **kw)

# ── shell 인젝션 차단용 안전 실행 헬퍼 ───────────────────────────────
# 이슈 title/body/summary 등 외부 입력이 셸 문자열로 보간되면 인젝션이 된다.
# gh/git 호출은 shell 없이 리스트 인자로 전달하고, 본문은 stdin(--body-file -)으로 넘긴다.
def gh(args, **kw):
    return subprocess.run(["gh", *args], capture_output=True, text=True, **kw)

def gh_comment(num, body):
    return subprocess.run(
        ["gh", "issue", "comment", str(num), "--repo", repo, "--body-file", "-"],
        input=body, capture_output=True, text=True)

def git(args, cwd=None):
    return subprocess.run(["git", *args], cwd=cwd or project_dir, capture_output=True, text=True)

# ── 기본 브랜치 동적 감지 (main 하드코딩 제거, lazy + cache) ──────────
_default_branch_cache = {}
def default_branch():
    if "v" not in _default_branch_cache:
        r = git(["symbolic-ref", "refs/remotes/origin/HEAD"])
        if r.returncode == 0 and r.stdout.strip():
            _default_branch_cache["v"] = r.stdout.strip().rsplit("/", 1)[-1]
        else:
            r2 = gh(["repo", "view", repo, "--json", "defaultBranchRef",
                     "-q", ".defaultBranchRef.name"])
            if r2.returncode == 0 and r2.stdout.strip():
                _default_branch_cache["v"] = r2.stdout.strip()
            else:
                _default_branch_cache["v"] = "main"
    return _default_branch_cache["v"]

def checkout_base():
    if git(["checkout", default_branch()]).returncode != 0:
        git(["checkout", "-"])

# ── claude 바이너리 1회 탐색 (bug/feature/question 공용) ─────────────
import glob as _glob2
_claude_candidates = [
    "/opt/homebrew/bin/claude",
    "/usr/local/bin/claude",
] + _glob2.glob(os.path.expanduser("~/.nvm/versions/node/*/bin/claude")) \
  + _glob2.glob(os.path.expanduser("~/.local/share/fnm/node-versions/*/installation/bin/claude"))
claude_bin = next((p for p in _claude_candidates if os.path.isfile(p)), None)

def classify_issue(title, body, labels):
    label_names = [l.get("name","").lower() for l in labels]
    text = (title + " " + body).lower()

    if any(l in label_names for l in ["bug", "fix", "error"]):
        return "bug"
    if any(l in label_names for l in ["feature", "enhancement", "feat"]):
        return "feature"
    if any(l in label_names for l in ["question", "help wanted"]):
        return "question"

    # 텍스트 기반 분류
    bug_words = ["bug", "오류", "에러", "error", "crash", "fail", "broken", "wrong", "fix", "수정"]
    feature_words = ["feature", "기능", "추가", "add", "implement", "want", "would like", "could", "request"]
    question_words = ["how", "어떻게", "why", "왜", "question", "help", "confused", "unclear"]

    bug_score    = sum(1 for w in bug_words     if w in text)
    feature_score = sum(1 for w in feature_words if w in text)
    question_score = sum(1 for w in question_words if w in text)

    if bug_score >= feature_score and bug_score >= question_score:
        return "bug" if bug_score > 0 else "skip"
    if feature_score >= question_score:
        return "feature"
    return "question"

def assess_complexity(title, body):
    """이슈 복잡도 평가: simple → haiku, standard → sonnet, complex → opus"""
    text = (title + " " + body).lower()

    complex_keywords = [
        "architecture", "아키텍처", "refactor", "리팩터", "refactoring",
        "design", "설계", "system", "시스템", "multiple files", "여러 파일",
        "breaking change", "migration", "마이그레이션", "performance", "성능",
        "security", "보안", "race condition", "concurrency", "동시성",
        "database schema", "스키마", "api design", "api 설계",
        "전체", "전반", "근본", "구조적"
    ]
    simple_keywords = [
        "typo", "오타", "spelling", "minor", "simple", "간단", "quick",
        "trivial", "small fix", "obvious", "명확", "one line",
        "한 줄", "주석", "comment fix", "whitespace", "formatting"
    ]

    complex_score = sum(1 for w in complex_keywords if w in text)
    simple_score = sum(1 for w in simple_keywords if w in text)
    body_length = len(body)

    if simple_score > 0 and complex_score == 0 and body_length < 200:
        return "simple"
    if complex_score >= 2 or body_length > 1500:
        return "complex"
    return "standard"

import pathlib

def load_routing():
    # collar_home(sys.argv[6]) 기준 — collar-eval-model이 쓰는 위치와 동일하게 맞춘다.
    routing_file = pathlib.Path(collar_home) / "model-routing.json"
    fallback = {
        "simple":   "claude-haiku-4-5-20251001",
        "standard": "claude-sonnet-4-6",
        "complex":  "claude-opus-4-7",
    }
    if not routing_file.exists():
        return fallback
    try:
        d = json.loads(routing_file.read_text())
        routing = d.get("routing", {})
        return {cat: routing[cat]["model"] for cat in ["simple", "standard", "complex"] if cat in routing}
    except Exception:
        return fallback

COMPLEXITY_MODEL = load_routing()

def _parse_stream_field(stdout, prefix):
    """claude stream-json 출력에서 'PREFIX:' 로 시작하는 라인의 값을 추출."""
    val = None
    for line in stdout.splitlines():
        try:
            obj = json.loads(line)
            texts = []
            if obj.get("type") == "result" and obj.get("subtype") == "success":
                texts.append(obj.get("result", ""))
            elif obj.get("type") == "assistant":
                for block in obj.get("message", {}).get("content", []):
                    if block.get("type") == "text":
                        texts.append(block.get("text", ""))
            for text in texts:
                for tline in text.splitlines():
                    if tline.startswith(prefix):
                        val = tline.replace(prefix, "", 1).strip()
        except Exception:
            pass
    return val


def review_diff(num, title):
    """변경된 diff를 review-agent(haiku)로 검토 → 한 줄 노트 반환."""
    diff_full = git(["diff", "HEAD~1", "HEAD"]).stdout[:6000]
    if not (diff_full and claude_bin):
        return ""
    review_prompt = (
        f"You are a code reviewer. Review this git diff for issue #{num}.\n\n"
        f"Issue: {title}\n\n"
        f"Diff:\n{diff_full}\n\n"
        f"Output exactly:\n"
        f"REVIEW_STATUS: APPROVED | NEEDS_WORK\n"
        f"REVIEW_NOTES: <one or two sentences — key risks or confirmation it looks correct>\n"
        f"No other text."
    )
    try:
        _t0 = time.time()
        rev_r = subprocess.run(
            [claude_bin, "--print", "-",
             "--output-format", "stream-json", "--verbose",
             "--dangerously-skip-permissions",
             "--model", "claude-haiku-4-5-20251001",
             "--max-turns", "1"],
            input=review_prompt, capture_output=True, text=True, timeout=60,
            cwd=project_dir,
        )
        log_usage("anthropic", "claude-haiku-4-5-20251001", "review",
                  int((time.time()-_t0)*1000), "ok" if rev_r.returncode == 0 else "error")
        status = _parse_stream_field(rev_r.stdout, "REVIEW_STATUS:") or "APPROVED"
        notes = _parse_stream_field(rev_r.stdout, "REVIEW_NOTES:") or ""
        print(f"       → 리뷰: {status} — {notes[:80]}")
        return notes
    except Exception as e:
        return f"리뷰 실패: {e}"


def implement_and_pr(kind, num, title, body, ts):
    """bug/feature 공통: claude 구현 → 커밋 → 리뷰 → push → PR. 성공 시 PR URL, 실패 시 None."""
    complexity = assess_complexity(title, body)
    fix_model = COMPLEXITY_MODEL[complexity]
    max_turns = {"simple": "10", "standard": "20", "complex": "30"}[complexity]
    is_bug = kind == "bug"
    prefix = "fix" if is_bug else "feat"
    verb = "버그 자동 수정" if is_bug else "기능 자동 구현"

    print(f"       → 복잡도: {complexity} → 모델: {fix_model}")
    print(f"       → {verb} 시작...")
    gh_comment(num, f"🤖 collar-github: {verb} 중입니다 (복잡도: {complexity}). 잠시 후 PR을 생성합니다.")

    if not claude_bin:
        print(f"       → claude 바이너리를 찾을 수 없습니다.")
        gh_comment(num, "🤖 collar-github: 자동 처리 환경(claude CLI)을 찾지 못했습니다. 수동 검토 필요합니다.")
        log_path.open("a").write(f"{ts} #{num} {kind}-no-claude: {title[:60]}\n")
        return None

    branch = f"collar/{prefix}-issue-{num}"
    if git(["checkout", "-b", branch]).returncode != 0:
        git(["checkout", branch])

    if is_bug:
        task_prompt = (
            f"Fix GitHub issue #{num} in this project.\n\n"
            f"Issue title: {title}\n"
            f"Issue body:\n{body[:1000]}\n\n"
            f"Instructions:\n"
            f"1. Read relevant source files to understand the bug\n"
            f"2. Make the minimal code changes needed to fix it\n"
            f"3. After all edits, output exactly: FIX_SUMMARY: <one-line description>\n"
        )
    else:
        task_prompt = (
            f"Implement the feature requested in GitHub issue #{num}.\n\n"
            f"Issue title: {title}\n"
            f"Issue body:\n{body[:1500]}\n\n"
            f"Instructions:\n"
            f"1. Read relevant source files to understand the codebase conventions\n"
            f"2. Implement the feature with minimal, focused changes that match existing style\n"
            f"3. Do NOT install new dependencies or run any publish commands\n"
            f"4. After all edits, output exactly: FIX_SUMMARY: <one-line description>\n"
        )

    summary = "CANNOT_FIX"
    changed_files = []
    try:
        _t0 = time.time()
        r = subprocess.run(
            [claude_bin, "--print", "-",
             "--output-format", "stream-json", "--verbose",
             "--dangerously-skip-permissions",
             "--model", fix_model,
             "--max-turns", max_turns],
            input=task_prompt, capture_output=True, text=True, timeout=600,
            cwd=project_dir,
        )
        log_usage("anthropic", fix_model, f"{kind}-{complexity}",
                  int((time.time()-_t0)*1000), "ok" if r.returncode == 0 else "error")
        parsed = _parse_stream_field(r.stdout, "FIX_SUMMARY:")
        if parsed:
            summary = parsed
        debug_log = log_path.parent / f"github-debug-{num}.txt"
        debug_log.write_text(f"FIX_SUMMARY: {summary}\n\nSTDOUT:\n{r.stdout[:4000]}\nSTDERR:\n{r.stderr[:1000]}")
        diff_r = git(["diff", "--name-only", "HEAD"])
        changed_files = [f.strip() for f in diff_r.stdout.splitlines() if f.strip()]
    except subprocess.TimeoutExpired:
        summary = "CANNOT_FIX (timeout)"
    except Exception as e:
        summary = f"CANNOT_FIX (error: {e})"

    if "CANNOT_FIX" in summary or not changed_files:
        checkout_base()
        git(["branch", "-D", branch])
        gh_comment(num, f"🤖 collar-github: 자동 처리에 실패했습니다 — {summary}. 수동 검토 필요합니다.")
        log_path.open("a").write(f"{ts} #{num} {kind}-failed: {title[:60]}\n")
        print(f"       → 자동 처리 불가: {summary}")
        return None

    git(["add", "-A"])
    git(["commit", "-m",
         f"{prefix}: #{num} {title[:50]}\n\nAuto-{prefix} by collar-github\n\n{summary}"])

    print(f"       → review-agent 실행 중...")
    review_notes = review_diff(num, title)

    push_r = git(["push", "-u", "origin", branch])
    checkout_base()
    if push_r.returncode != 0:
        log_path.open("a").write(f"{ts} #{num} {kind}-push-failed: {title[:60]}\n")
        print(f"       → push 실패: {push_r.stderr[:100]}")
        return None

    review_section = f"\n\n**🔍 review-agent:** {review_notes}" if review_notes else ""
    pr_body = (
        f"{'Fixes' if is_bug else 'Implements'} #{num}\n\n"
        f"🤖 자동 생성 PR by collar-github\n\n"
        f"**내용:** {summary}\n\n"
        f"**변경 파일:** {', '.join(changed_files)}"
        f"{review_section}"
    )
    pr_r = subprocess.run(
        ["gh", "pr", "create", "--repo", repo, "--base", default_branch(),
         "--head", branch, "--title", f"{prefix}: {title[:60]}", "--body-file", "-"],
        input=pr_body, capture_output=True, text=True)
    if pr_r.returncode == 0:
        pr_url = pr_r.stdout.strip()
        gh_comment(num, f"✅ {prefix} PR 생성: {pr_url}\n\n내용: {summary}")
        log_path.open("a").write(f"{ts} #{num} {kind}-done PR={pr_url}: {title[:60]}\n")
        print(f"       → PR 생성: {pr_url}")
        return pr_url
    log_path.open("a").write(f"{ts} #{num} {kind}-pr-failed: {title[:60]}\n")
    print(f"       → PR 생성 실패 (branch pushed): {pr_r.stderr[:100]}")
    return None


def answer_question(num, title, body, ts):
    """question: claude(haiku)로 답변 생성 → 이슈에 댓글. 실패 시 정적 댓글."""
    fallback = "👋 collar-github: 질문으로 분류했습니다. 담당자가 확인 후 답변할 예정입니다."
    if not claude_bin:
        gh_comment(num, fallback)
        print(f"       → 질문 댓글 등록 (claude 미설치)")
        return
    q_prompt = (
        f"You are a helpful maintainer answering a GitHub issue question for this repository.\n"
        f"Read the relevant project files if needed, then write a concise, accurate answer "
        f"in the same language as the question.\n\n"
        f"Question title: {title}\n"
        f"Question body:\n{body[:1500]}\n\n"
        f"Output exactly:\n"
        f"ANSWER: <your answer, may span multiple lines>\n"
    )
    try:
        _t0 = time.time()
        r = subprocess.run(
            [claude_bin, "--print", "-",
             "--output-format", "stream-json", "--verbose",
             "--dangerously-skip-permissions",
             "--model", "claude-haiku-4-5-20251001",
             "--max-turns", "5"],
            input=q_prompt, capture_output=True, text=True, timeout=180,
            cwd=project_dir,
        )
        log_usage("anthropic", "claude-haiku-4-5-20251001", "question",
                  int((time.time()-_t0)*1000), "ok" if r.returncode == 0 else "error")
        answer = _parse_stream_field(r.stdout, "ANSWER:")
        if answer:
            gh_comment(num,
                       f"🤖 collar-github 자동 답변:\n\n{answer}\n\n---\n"
                       f"_AI가 생성한 답변입니다. 정확하지 않을 수 있으니 담당자 확인을 권장합니다._")
            print(f"       → 질문 자동 답변 등록")
        else:
            gh_comment(num, fallback)
            print(f"       → 답변 생성 실패, 분류 댓글만 등록")
    except Exception:
        gh_comment(num, fallback)
        print(f"       → 답변 처리 오류, 분류 댓글만 등록")


for issue in issues:
    num   = str(issue["number"])
    title = issue["title"]
    body  = issue.get("body","") or ""
    labels = issue.get("labels",[])

    if num in processed:
        print(f"  #{num} [{title[:40]}] → 이미 처리됨. 건너뜀.")
        continue

    kind = classify_issue(title, body, labels)
    ts   = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")

    print(f"\n  #{num} [{title[:50]}]")
    print(f"       분류: {kind}")

    if kind == "skip":
        print(f"       → 처리 불필요. 건너뜀.")
        log_path.open("a").write(f"{ts} #{num} skip: {title[:60]}\n")
        continue

    # ── 라벨 자동 적용 (shell 없이 인자 전달) ──────────────────────
    label_map = {"bug": "bug", "feature": "enhancement", "question": "question"}
    gh(["issue", "edit", num, "--repo", repo, "--add-label", label_map[kind]])

    if kind == "question":
        if auto_level >= 2:
            answer_question(num, title, body, ts)
        else:
            gh_comment(num, "👋 collar-github: 질문으로 분류했습니다. 담당자가 확인 후 답변할 예정입니다.")
            print(f"       → 질문 댓글 등록")
        log_path.open("a").write(f"{ts} #{num} question: {title[:60]}\n")
        continue

    if kind == "bug" and auto_level >= 2:
        implement_and_pr("bug", num, title, body, ts)
    elif kind == "feature" and auto_level >= 3:
        implement_and_pr("feature", num, title, body, ts)
    elif kind == "feature":
        # auto_level < 3 → 자동 구현 대신 로드맵 기록
        roadmap = pathlib.Path(project_dir) / ".collar" / "roadmap.md"
        roadmap.parent.mkdir(parents=True, exist_ok=True)
        with roadmap.open("a") as f:
            f.write(f"\n- [ ] #{num}: {title} (자동 추가 {ts})\n")
        gh_comment(num, "📝 collar-github: 기능 요청이 로드맵에 추가됐습니다 (자동 구현은 auto_level 3 이상에서 동작).")
        log_path.open("a").write(f"{ts} #{num} feature-roadmap: {title[:60]}\n")
        print(f"       → 로드맵 기록")
    else:
        # bug인데 auto_level < 2 → 라벨 + 분류 댓글만
        comment = "🏷️ collar-github: `bug`로 분류했습니다. 버그 자동수정이 비활성화됨 (auto_level<2)"
        gh_comment(num, comment)
        log_path.open("a").write(f"{ts} #{num} {kind}-labeled: {title[:60]}\n")
        print(f"       → 라벨 + 댓글 등록")

print("\n✅ collar-github run 완료.")
PYEOF
}

# ── watch: SessionStart 훅 등록 ──────────────────────────────────
cmd_watch() {
  require_collar
  CLAUDE_DIR="$TARGET/.claude"
  SETTINGS_FILE="$CLAUDE_DIR/settings.json"
  WATCH_HOOK="$COLLAR_DIR/hooks/github-check.sh"

  # github-check.sh 설치
  cp "$COLLAR_HOME/templates/github-check.sh" "$WATCH_HOOK" 2>/dev/null || {
    # 템플릿 없으면 인라인 생성
    cat > "$WATCH_HOOK" << 'HOOKEOF'
#!/usr/bin/env bash
# collar github-check hook (SessionStart)
COLLAR_DIR="$(cd "$(dirname "$0")/.." && pwd)"
GITHUB_CONFIG="$COLLAR_DIR/github.json"
[ -f "$GITHUB_CONFIG" ] || exit 0
ENABLED="$(python3 -c "import json,pathlib; d=json.loads(pathlib.Path('$GITHUB_CONFIG').read_text()); print(d.get('enabled','false'))" 2>/dev/null || echo false)"
[ "$ENABLED" = "True" ] || exit 0
collar-github run 2>/dev/null || "$HOME/Documents/dev/ai/collar/bin/collar-github" run 2>/dev/null || true
HOOKEOF
  }
  chmod +x "$WATCH_HOOK"

  # settings.json에 SessionStart 훅 등록
  [ -f "$SETTINGS_FILE" ] || echo '{"permissions":{"allow":[],"deny":[]}}' > "$SETTINGS_FILE"
  python3 - "$SETTINGS_FILE" "$COLLAR_DIR/collar-dispatcher.sh" << 'PYEOF'
import sys, json, pathlib

sp = pathlib.Path(sys.argv[1])
dispatcher = sys.argv[2]
d = json.loads(sp.read_text())
if "hooks" not in d:
    d["hooks"] = {}

# SessionStart에 dispatcher 추가 (없을 경우만)
if "SessionStart" not in d["hooks"]:
    d["hooks"]["SessionStart"] = []
already = any("collar-dispatcher" in str(h) for entry in d["hooks"]["SessionStart"] for h in entry.get("hooks",[]))
if not already:
    d["hooks"]["SessionStart"].append({
        "hooks": [{"type": "command", "command": f"bash '{dispatcher}'", "timeout": 30}]
    })

sp.write_text(json.dumps(d, indent=2, ensure_ascii=False))
print("OK")
PYEOF

  echo "✅ collar-github watch 등록 완료"
  echo "   SessionStart 시마다 미처리 이슈 자동 확인"
  echo "   훅: $WATCH_HOOK"
}

# ── help ─────────────────────────────────────────────────────────
cmd_help() {
  cat << 'EOF'
collar-github — GitHub 이슈 자동 처리 파이프라인

사용법:
  collar-github setup    GitHub 연동 설정 (레포, 자동처리 레벨)
  collar-github run      미처리 이슈 일괄 처리
  collar-github status   현재 상태 확인
  collar-github watch    세션 시작마다 자동 감시 등록

자동처리 레벨:
  1  분류 + 라벨 + 댓글만         (안전, 코드 변경 없음)
  2  레벨1 + bug 자동 수정 PR     (권장)
  3  레벨2 + feature PR (단순)    (공격적)

처리 흐름:
  이슈 수집 → LLM 분류 → 라벨/댓글 → (bug→PR, feature→로드맵, question→답변)
  → .collar/github-processed.log 기록

EOF
}

# ── 라우팅 ────────────────────────────────────────────────────────
case "$SUBCOMMAND" in
  setup)   cmd_setup   ;;
  run)     cmd_run     ;;
  status)  cmd_status  ;;
  watch)   cmd_watch   ;;
  help|--help|-h) cmd_help ;;
  *) echo "알 수 없는 명령: $SUBCOMMAND"; cmd_help; exit 1 ;;
esac
